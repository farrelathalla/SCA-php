# Uploaded files are served as data only — never executed.
<FilesMatch "\.(php|phtml|php\d|phar|pl|py|cgi|sh|shtml|html?)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
